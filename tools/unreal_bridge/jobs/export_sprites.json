            "frame": 0,
            "match": [
              "barbarian"
            ],
            "yaw": 0,
            "scale": 1.8
          },
          {
            "name": "boss",
            "frame": 1,
            "match": [
              "barbarian"
            ],
            "yaw": 14,
            "scale": 1.8
          },
          {
            "name": "tower_gun",
