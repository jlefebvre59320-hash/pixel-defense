{
  "name": "export_sprites",
  "description": "Photographie les maillages des packs CC0 importés en vue 3/4 orthographique, un PNG par figure du jeu web.",
  "steps": [
    {
      "name": "Contrôle du moteur",
      "script": "unreal/Content/Python/healthcheck.py",
      "continue_on_error": true
    },
    {
      "name": "Capture des sprites",
      "script": "unreal/Content/Python/export_sprites.py",
      "timeout": 1200,
      "comment": "Chaque figure est décrite par des mots-clés (« match »), pas par un chemin : les chemins exacts dépendent de l'arborescence des packs KayKit, et c'est le moteur qui les connaît. Le compte rendu dit, figure par figure, quel maillage a été retenu et avec quel score — corrigez les mots-clés, ajoutez « avoid », ou forcez un chemin avec « asset », d'après ce qu'il annonce. L'ordre compte : à égalité, la première figure servie garde le maillage, d'où la forteresse en tête. L'inventaire complet s'obtient avec le travail production_asset_inventory_09.",
      "params": {
        "search_paths": [
          "/Game/ThirdParty",
          "/Game/Art"
        ],
        "size": 512,
        "frame_cm": 300.0,
        "pitch": -32.0,
        "yaw": 45.0,
        "background": [
          1.0,
          0.0,
          1.0
        ],
        "figures": [
          {
            "name": "core",
            "frame": 0,
            "match": [
              "building",
              "castle"
            ],
            "scale": 1.6,
            "avoid": [
              "wall"
            ]
          },
          {
            "name": "crawler",
            "frame": 0,
            "match": [
              "skeleton",
              "minion"
            ],
            "yaw": 0
          },
          {
            "name": "crawler",
            "frame": 1,
            "match": [
              "skeleton",
              "minion"
            ],
            "yaw": 14
          },
          {
            "name": "swarm",
            "frame": 0,
