[gd_scene load_steps=5 format=3]

; Scène principale. Elle ne décrit que la structure : l'habillage (couleurs,
; cadres, tailles de police) est posé au démarrage par ui.gd, en un seul
; endroit. Le plateau (Board) est un Node2D mis à l'échelle par board.gd pour
; occuper exactement la place laissée libre par l'interface — c'est le rôle du
; nœud « Spacer ».

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/board.gd" id="2_board"]
[ext_resource type="Script" path="res://scripts/fx.gd" id="3_fx"]
[ext_resource type="Script" path="res://scripts/ui.gd" id="4_ui"]

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

[node name="Board" type="Node2D" parent="."]
script = ExtResource("2_board")

[node name="Terrain" type="Sprite2D" parent="Board"]
centered = false

[node name="Entities" type="Node2D" parent="Board"]

[node name="Fx" type="Node2D" parent="Board"]
z_index = 2
script = ExtResource("3_fx")

[node name="UI" type="CanvasLayer" parent="."]
script = ExtResource("4_ui")

[node name="Root" type="MarginContainer" parent="UI"]
mouse_filter = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="Col" type="VBoxContainer" parent="UI/Root"]
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Hud" type="HBoxContainer" parent="UI/Root/Col"]
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Lives" type="PanelContainer" parent="UI/Root/Col/Hud"]
mouse_filter = 2
size_flags_horizontal = 3

[node name="Box" type="HBoxContainer" parent="UI/Root/Col/Hud/Lives"]
mouse_filter = 2
alignment = 1
theme_override_constants/separation = 6

[node name="Name" type="Label" parent="UI/Root/Col/Hud/Lives/Box"]
text = "VIES"

[node name="Value" type="Label" parent="UI/Root/Col/Hud/Lives/Box"]
text = "15"

[node name="Gold" type="PanelContainer" parent="UI/Root/Col/Hud"]
mouse_filter = 2
size_flags_horizontal = 3

[node name="Box" type="HBoxContainer" parent="UI/Root/Col/Hud/Gold"]
mouse_filter = 2
alignment = 1
theme_override_constants/separation = 6

[node name="Name" type="Label" parent="UI/Root/Col/Hud/Gold/Box"]
text = "OR"

[node name="Value" type="Label" parent="UI/Root/Col/Hud/Gold/Box"]
text = "130"

[node name="Wave" type="PanelContainer" parent="UI/Root/Col/Hud"]
mouse_filter = 2
size_flags_horizontal = 3

[node name="Box" type="HBoxContainer" parent="UI/Root/Col/Hud/Wave"]
mouse_filter = 2
alignment = 1
theme_override_constants/separation = 6

[node name="Name" type="Label" parent="UI/Root/Col/Hud/Wave/Box"]
text = "VAGUE"

[node name="Value" type="Label" parent="UI/Root/Col/Hud/Wave/Box"]
text = "0/20"

[node name="Score" type="PanelContainer" parent="UI/Root/Col/Hud"]
mouse_filter = 2
size_flags_horizontal = 3

[node name="Box" type="HBoxContainer" parent="UI/Root/Col/Hud/Score"]
mouse_filter = 2
alignment = 1
theme_override_constants/separation = 6

[node name="Name" type="Label" parent="UI/Root/Col/Hud/Score/Box"]
text = "SCORE"

[node name="Value" type="Label" parent="UI/Root/Col/Hud/Score/Box"]
text = "0"

[node name="Spacer" type="Control" parent="UI/Root/Col"]
size_flags_vertical = 3
mouse_filter = 2

[node name="Sheet" type="PanelContainer" parent="UI/Root/Col"]
visible = false

[node name="Col" type="VBoxContainer" parent="UI/Root/Col/Sheet"]
theme_override_constants/separation = 8

[node name="Head" type="HBoxContainer" parent="UI/Root/Col/Sheet/Col"]

[node name="Title" type="Label" parent="UI/Root/Col/Sheet/Col/Head"]
size_flags_horizontal = 3
text = "Construire"

[node name="Close" type="Button" parent="UI/Root/Col/Sheet/Col/Head"]
text = "Fermer"

[node name="Cards" type="HBoxContainer" parent="UI/Root/Col/Sheet/Col"]
theme_override_constants/separation = 6

[node name="Info" type="HBoxContainer" parent="UI/Root/Col/Sheet/Col"]
visible = false
theme_override_constants/separation = 12

[node name="Icon" type="TextureRect" parent="UI/Root/Col/Sheet/Col/Info"]
custom_minimum_size = Vector2(44, 44)
texture_filter = 1
expand_mode = 1
stretch_mode = 5

[node name="Stats" type="Label" parent="UI/Root/Col/Sheet/Col/Info"]
size_flags_horizontal = 3
text = "Dégâts"

[node name="Hint" type="Label" parent="UI/Root/Col/Sheet/Col"]
custom_minimum_size = Vector2(0, 34)
autowrap_mode = 3
text = "Appuyez sur une tour pour voir sa portée."

[node name="Actions" type="HBoxContainer" parent="UI/Root/Col/Sheet/Col"]
visible = false
theme_override_constants/separation = 6

[node name="Upgrade" type="Button" parent="UI/Root/Col/Sheet/Col/Actions"]
custom_minimum_size = Vector2(0, 46)
size_flags_horizontal = 3
text = "Améliorer"

[node name="Sell" type="Button" parent="UI/Root/Col/Sheet/Col/Actions"]
custom_minimum_size = Vector2(0, 46)
text = "Vendre"

[node name="Bar" type="HBoxContainer" parent="UI/Root/Col"]
theme_override_constants/separation = 6

[node name="Wave" type="Button" parent="UI/Root/Col/Bar"]
custom_minimum_size = Vector2(0, 48)
size_flags_horizontal = 3
text = "Commencer"

[node name="Speed" type="Button" parent="UI/Root/Col/Bar"]
custom_minimum_size = Vector2(58, 48)
text = "×1"

[node name="Sound" type="Button" parent="UI/Root/Col/Bar"]
custom_minimum_size = Vector2(52, 48)
text = "♪"

[node name="Pause" type="Button" parent="UI/Root/Col/Bar"]
custom_minimum_size = Vector2(52, 48)
text = "❚❚"

[node name="Toast" type="PanelContainer" parent="UI"]
visible = false
mouse_filter = 2
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -110.0
offset_top = -150.0
offset_right = 110.0
offset_bottom = -110.0
grow_horizontal = 2
grow_vertical = 0

[node name="Label" type="Label" parent="UI/Toast"]
text = "Vague 1"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Overlay" type="Control" parent="UI"]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dim" type="ColorRect" parent="UI/Overlay"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.035, 0.04, 0.086, 0.88)

[node name="Center" type="CenterContainer" parent="UI/Overlay"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="UI/Overlay/Center"]
custom_minimum_size = Vector2(320, 0)

[node name="Col" type="VBoxContainer" parent="UI/Overlay/Center/Panel"]
theme_override_constants/separation = 10

[node name="Kicker" type="Label" parent="UI/Overlay/Center/Panel/Col"]
text = "Tower defense de poche"
horizontal_alignment = 1

[node name="Title" type="Label" parent="UI/Overlay/Center/Panel/Col"]
text = "PIXEL DEFENSE"
horizontal_alignment = 1

[node name="Lines" type="VBoxContainer" parent="UI/Overlay/Center/Panel/Col"]
theme_override_constants/separation = 8

[node name="Buttons" type="VBoxContainer" parent="UI/Overlay/Center/Panel/Col"]
theme_override_constants/separation = 8
